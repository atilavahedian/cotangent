{
  "device": "mps",
  "precision": "bf16",
  "cpu_threads": 4,
  "model": {
    "width": 512,
    "layers": 6,
    "heads": 8,
    "sequence": 256,
    "vocab": 256
  },
  "batch_size": 8,
  "steps": 1500,
  "learning_rate": 0.001,
  "lr_warmup": 100,
  "log_every": 10,
  "eval_every": 100,
  "eval_batches": 32,
  "policy": {
    "fraction": 0.25,
    "tolerance": 0.5,
    "audit_every": 32,
    "warmup": 8,
    "min_rows": 64,
    "mixture": 0.05
  }
}
